<%@ page pageEncoding="UTF-8" %>
<section class="panel report-filters">
<form id="report-form" class="toolbar">
<div>
<label for="report-from">Từ ngày</label>
<input id="report-from" name="from" type="date" required>
</div>
<div>
<label for="report-to">Đến ngày</label>
<input id="report-to" name="to" type="date" required>
</div>
<button class="button primary" type="submit">Xem báo cáo</button>
<button id="report-export" class="button secondary" type="button" disabled>Tải CSV</button>
</form>
<p class="muted">Theo ngày kinh doanh của hóa đơn đã thu đủ. Hoàn tiền được gắn về hóa đơn gốc.</p>
</section>
<section class="stats-grid">
<article class="stat-card">
<span>Số hóa đơn</span>
<strong id="report-orders">—</strong>
</article>
<article class="stat-card">
<span>Giá trị bán</span>
<strong id="report-gross">—</strong>
</article>
<article class="stat-card">
<span>Đã hoàn</span>
<strong id="report-refunds">—</strong>
</article>
<article class="stat-card">
<span>Doanh thu thuần</span>
<strong id="report-net">—</strong>
</article>
</section>
<section class="panel">
<div class="panel-heading">
<div>
<h2>Doanh thu theo ngày</h2>
<p class="muted" id="report-description">Chọn kỳ để xem dữ liệu thực tế.</p>
</div>
</div>
<div id="report-chart" class="bar-chart" aria-label="Biểu đồ doanh thu">
</div>
<div id="report-table" class="table-wrap">
</div>
</section>
